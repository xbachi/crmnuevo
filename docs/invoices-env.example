# Postgres connection
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_vehiculos"

# Redis (BullMQ queue)
REDIS_URL="redis://localhost:6379/0"

############################################
# Microsoft Graph (App Registration - Client Credentials)
############################################
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# Drive to operate on (OneDrive / SharePoint Drive ID)
MS_GRAPH_DRIVE_ID=""

# Base folder in OneDrive (optional)
MS_GRAPH_BASE_PATH="/Concesionaria"

# Outlook mailbox user id (UPN/email or GUID) used for /users/{id}/... calls (optional)
MS_GRAPH_MAILBOX_USER_ID=""

############################################
# Worker
############################################
INVOICES_WORKER_CONCURRENCY="4"

# Optional: if set, API endpoints /api/invoices/* require header x-api-key=<value>
INVOICES_API_KEY=""


