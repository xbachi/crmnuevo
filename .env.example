# =============================================================================
# crmnuevo (SevenCars CRM) — environment variables
# Copy this file to `.env.local` (gitignored) and fill in real values.
# =============================================================================

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string (Supabase pooler URL recommended for serverless).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# --- Required for production file uploads -----------------------------------

# Vercel Blob storage token. Get it from Vercel dashboard:
#   Storage -> Blob -> .env.local snippet
# Without this, /api/vehiculos/[id]/archivos and inversor uploads fail in prod.
BLOB_READ_WRITE_TOKEN=

# --- Optional: Google Sheets sync -------------------------------------------
# Used by src/lib/googleSheets.ts. The sync is currently gated by quota in
# src/config/syncConfig.ts; leave blank to disable.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full PEM string with literal "\n" newlines, wrapped in quotes.
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Optional: framework / tooling ------------------------------------------

# Next.js auto-injects on Vercel. Set locally only if you need to simulate prod.
# NODE_ENV=development
# NEXT_TELEMETRY_DISABLED=1

# Auto-injected by Vercel at runtime; do not set manually:
#   VERCEL=1
#   VERCEL_ENV=production|preview|development
#   VERCEL_URL=<deployment-host-without-protocol>

# --- Optional: tests --------------------------------------------------------
# Used by Playwright E2E (playwright.config.ts) and integration tests.
# TEST_BASE_URL=http://localhost:3000
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=crmnuevo_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=postgres
