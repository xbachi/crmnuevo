# Copiar como .env (en esta misma carpeta, sevencars-fichas/) y completar con los datos reales.
# .env no se sube a git; este archivo sí, así que aquí solo van valores de ejemplo.

# ---- Avisos por mail del vigilante (vigilar.py). Probar con: ../.venv/bin/python vigilar.py --probar-mail
# Servidor SMTP: puerto 465 = SSL; cualquier otro (p. ej. 587) = STARTTLS.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=465
SMTP_USER=avisos@ejemplo.com
SMTP_PASS=contraseña-de-ejemplo
# Remitente (si falta, se usa SMTP_USER) y nombre que se ve en el buzón.
SMTP_FROM=avisos@ejemplo.com
SMTP_FROMNAME=Vigilante Sevencars
# A quién avisar: una dirección o varias separadas por coma.
AVISOS_TO=duenio@ejemplo.com,otra@ejemplo.com
# 1 = avisar también cada vez que se crea un borrador en la web; 0 = solo lo que requiere atención.
AVISOS_BORRADOR=1
# 0 = apagar todos los avisos por mail.
AVISOS_ACTIVOS=1
# Opcional: otro archivo .env de donde leer lo que no esté aquí.
# AVISOS_ENV_FILE=/home/usuario/otro-proyecto/.env
